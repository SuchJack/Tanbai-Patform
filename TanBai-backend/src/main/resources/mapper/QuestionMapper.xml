<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.truthgame.mapper.QuestionMapper">

    <resultMap id="BaseResultMap" type="com.truthgame.model.entity.Question">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="creatorId" column="creatorId" jdbcType="BIGINT"/>
            <result property="content" column="content" jdbcType="VARCHAR"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
            <result property="isPaid" column="isPaid" jdbcType="TINYINT"/>
            <result property="seeReply" column="seeReply" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,creatorId,content,
        createTime,updateTime,isPaid,
        seeReply
    </sql>
</mapper>
